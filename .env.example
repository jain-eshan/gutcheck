# gutcheck optional API keys. Everything works without these - each one adds a source
# or raises a rate limit. Run `/gutcheck setup` in Claude Code for step-by-step help.
# Format: KEY=value, one per line. This file stays on your computer.

# YouTube video views and comments. Free, about 3 minutes to get.
YOUTUBE_API_KEY=

# Raises GitHub search from 10 to 30 a minute. Free.
GITHUB_TOKEN=

# Company registration lookups (OpenCorporates).
OPENCORPORATES_API_TOKEN=

# Reddit official API: adds scores/comment counts and removes the 1-search-a-minute limit.
# Reddit reviews new API apps by hand, so this can take days.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
